# .dockerignore

# Dependencies (rebuilt in container)
node_modules

# Build output (rebuilt in container)
.next
out
build

# Git
.git
.gitignore

# Environment files (secrets — passed via docker-compose)
.env
.env.*

# IDE / editor
.vscode
.idea
.history
*.swp
*.swo
.DS_Store

# Documentation and plans (CHANGELOG.md is needed by /api/changelog)
docs
*.md
!CHANGELOG.md
!package.json

# Tests (not needed in production image)
**/*.test.ts
**/*.test.tsx
**/__tests__
coverage
vitest.config.*

# CI / tooling config
.github
.claude
.serena
.interface-design
.biomeignore
biome.json

# Development scripts.
#
# scripts/recover.cjs is the emergency password-recovery CLI and
# scripts/backfill-buffer.cjs is the signed-buffer history repair; both are
# operator tools that MUST reach the build context — the Dockerfile copies them
# into the runner. Write this as `scripts/*` + negations, never as a bare
# `scripts` + negation: re-including a child of a wholly-excluded directory is
# not reliable across BuildKit versions, and the failure mode is a COPY error
# mid-build.
scripts/*
!scripts/recover.cjs
!scripts/backfill-buffer.cjs

# Drizzle generated migrations (schema-push used instead)
drizzle
