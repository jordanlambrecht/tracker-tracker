{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": ["**", "!.next", "!node_modules", "!public", "!.history", "!docs/kb/site"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "echarts-gl": "echarts-gl registers WebGL renderers at module scope. Only VolumeSurface3D/TorrentAgeScatter3D may import it, and both are reached exclusively through dynamic(..., { ssr: false }). Importing it anywhere else pulls WebGL into that bundle, including the server render path. To reuse a 3D chart's helpers, move the shared code into chart-transforms.ts instead, which imports only formatters and types."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/tracker-platforms/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/lib/tracker-platforms/adapters/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/lib/tunnel": "Adapters reach the network through adapterFetch, adapterRequest or fetchTrackerHtml in ../helpers, which apply the shared timeout, the default User-Agent and the proxy in one place. Importing @/lib/tunnel directly reimplements the proxy branch and skips all three. torrentleech.ts is the one exception, declared in its own override below, because its login POST needs to read Set-Cookie through the proxy."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/tracker-platforms/adapters/torrentleech.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/charts/VolumeSurface3D.tsx",
        "src/components/charts/TorrentAgeScatter3D.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  }
}
