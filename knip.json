{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "exports": "warn",
    "types": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  },
  "entry": ["scripts/{recover,backfill-buffer}.cjs!"],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "!src/test/**!",
    "!src/data/tracker-validation-rules.ts!",
    "scripts/**/*.{ts,cjs,mjs}"
  ],
  "ignoreFiles": ["src/data/trackers/_template.ts"],
  "ignoreDependencies": ["conventional-changelog", "drizzle-kit!"],
  "next": true,
  "typescript": true,
  "biome": true,
  "eslint": false,
  "drizzle": false,
  "ignoreExportsUsedInFile": { "interface": true, "type": true }
}
